# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Turso database (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# API secret — minimum 8 chars, used for all endpoint auth
RSS_SECRET=your-secret-here

# Publicly accessible base URL of this service (no trailing slash)
SERVICE_URL=https://your-service-url.example.com

# Server port (Cloud Run / Cloud Functions ignores this; used for local dev only)
PORT=8080

# Maximum articles returned per request (default 200, hard cap in code)
ARTICLES_MAX_LIMIT=200

# CloudMailin outbound (optional) — used to forward emails with no extractable articles
CLOUDMAILIN_USERNAME=
CLOUDMAILIN_API_KEY=
REVIEW_RECIPIENT_EMAIL=

# GCP Cloud Functions — async ingest worker (set automatically by deploy.ps1)
GCP_PROJECT=
GCP_REGION=europe-west1
TASKS_QUEUE=newsletter-ingest
INGEST_WORKER_URL=
