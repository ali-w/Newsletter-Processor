{
  "name": "newsletter-processor",
  "version": "1.0.0",
  "description": "Backend service for processing email newsletters via CloudMailin webhook, LLM extraction, and RSS/JSON feed generation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:functions": "tsc -p tsconfig.functions.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "test": "jest"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "@google-cloud/storage": "^7.0.0",
    "@google-cloud/tasks": "^6.2.2",
    "@google/genai": "1.51.0",
    "@libsql/client": "^0.14.0",
    "@mozilla/readability": "^0.5.0",
    "cloudmailin": "^0.3.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsdom": "^26.0.0",
    "rss": "^1.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@types/rss": "^0.0.32",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
